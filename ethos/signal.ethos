; Ethos-zero ordinary signal — the generation wire contract.
;
; The connection carries signal's exchange layer. A peer greets once,
; settling this contract by the digest of this file; after that every
; query opens an exchange the peer names. Generate and Observe are
; answered with one frame on that exchange, which then ends. Subscribe
; answers on its exchange with each generation event until the peer
; abandons the exchange.
Signal
[]
[ Generate.GenerationRequest
  Observe.ObservationSelection
  Subscribe.SubscriptionRequest
  Unsubscribe.SubscriptionRequest ]
[ Generated.Generation
  Observed.Observation
  GenerationRejected.GenerationRefusal
  GenerationStarted.GenerationRequest
  GenerationCompleted.Generation
  GenerationRefused.GenerationRefusal ]
[ SourceName.String
  RelativePath.String
  ArtifactPath.String
  FileLocation.{ SourceName RelativePath }
  GenerationRequest.{ FileLocation }
  SubscriptionRequest.{ FileLocation }
  Generation.{ FileLocation ArtifactPath }
  ObservationSelection.[ Assemblies ]
  AssemblySummary.{ FileLocation ArtifactPath }
  AssemblySnapshot.{ Vector<AssemblySummary> }
  Observation.[ Assemblies.AssemblySnapshot ]
  ExtentStart.Integer
  ExtentEnd.Integer
  SourceExtent.{ ExtentStart ExtentEnd }
  SyntaxFaultReason.String
  SyntaxFault.{ SourceExtent SyntaxFaultReason }
  ProjectionFaultReason.String
  ProjectionFault.{ ProjectionFaultReason }
  GenerationRefusal.[ UnknownSource.SourceName
                      FileAbsent.FileLocation
                      ImportUnresolved.FileLocation
                      InvalidRelativePath.RelativePath
                      InvalidEthos.SyntaxFault
                      RustProjectionRejected.ProjectionFault ] ]
